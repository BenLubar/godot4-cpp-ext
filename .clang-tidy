Checks:
  - bugprone-*
  - clang-analyzer-*
  - concurrency-*
  - modernize-*
  - performance-*
  - readability-*
  - -bugprone-derived-method-shadowing-base-method
  - -bugprone-easily-swappable-parameters
  - -bugprone-lambda-function-name
  - -bugprone-narrowing-conversions
  - -bugprone-signed-bitwise
  - -bugprone-switch-missing-default-case
  - -bugprone-throwing-static-initialization
  - -bugprone-unhandled-code-paths
  - -modernize-macro-to-enum
  - -modernize-use-auto
  - -modernize-use-integer-sign-comparison
  - -modernize-use-trailing-return-type
  - -modernize-use-using
  - -performance-enum-size
  - -readability-convert-member-functions-to-static
  - -readability-else-after-return
  - -readability-function-cognitive-complexity
  - -readability-identifier-length
  - -readability-inconsistent-declaration-parameter-name
  - -readability-inconsistent-ifelse-braces
  - -readability-magic-numbers
  - -readability-make-member-function-const
  - -readability-redundant-inline-specifier
  - -readability-redundant-nested-if
  - -readability-redundant-typename
  - -readability-uppercase-literal-suffix
  - -readability-use-anyofallof
FormatStyle: file
HeaderFilterRegex: '.*\.h$'
ExcludeHeaderFilterRegex: '(^|.*/)(thirdparty|squirrel|mbedtls|KTX-Software)/.*'
CheckOptions:
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  modernize-avoid-c-arrays.AllowStringArrays: true
  readability-simplify-boolean-expr.IgnoreMacros: true
